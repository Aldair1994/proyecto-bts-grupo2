# Copiar a .env y cambiar la contraseña. El archivo .env NO se sube al repositorio.
POSTGRES_DB=bts
POSTGRES_USER=bts_admin
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_PORT=5432

# Variables que usan los scripts de Python (libpq las lee directamente)
PGDATABASE=bts
PGUSER=bts_admin
PGPASSWORD=cambiar_esta_contrasena
# Fuera de Docker (corriendo Python en tu máquina contra el servidor):
# PGHOST=<ip del servidor o de Tailscale>
# PGPORT=5432
